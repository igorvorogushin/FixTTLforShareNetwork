<Window x:Class="TTLFixWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="560" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F6F7FA">
  <Window.Resources>
    <Style x:Key="ModeButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="24" Padding="20" Background="White" CornerRadius="12" BorderBrush="#19000000" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Subtitle}" Foreground="#636B7A" Margin="0,4,0,0"/>
        </StackPanel>
        <ComboBox Grid.Column="1" SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag" Height="28" VerticalAlignment="Top">
          <ComboBoxItem Content="{Binding RussianLabel}" Tag="ru"/>
          <ComboBoxItem Content="{Binding EnglishLabel}" Tag="en"/>
        </ComboBox>
      </Grid>

      <Button Grid.Row="2" Style="{StaticResource ModeButton}" Background="{Binding ToggleBrush}"
              IsEnabled="{Binding CanToggle}" Click="Toggle_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ToggleIcon}" FontSize="20" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding ToggleLabel}"/>
        </StackPanel>
      </Button>

      <StackPanel Grid.Row="4" Orientation="Horizontal">
        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="4,0,10,0" VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="{Binding ErrorTitle}" Foreground="#B22222" FontWeight="SemiBold">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Foreground="{Binding StatusBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding NormalStatus}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="{Binding Status}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Text" Value="{Binding Status}"/></DataTrigger>
              </Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button Content="{Binding RouteLabel}" Click="Help_Click" BorderThickness="0" Background="Transparent"
                Foreground="#457AF5" FontWeight="SemiBold" Padding="0"/>
        <TextBlock Grid.Column="2" Text="{Binding Footer}" Foreground="#636B7A" FontSize="12" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
  </Border>
</Window>
